rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Profile pictures: avatars/<uid>.jpg
    // Only the owner can read or write their own avatar (least privilege).
    // The download URL carries a token, so display still works once shared.
    match /avatars/{userId} {
      allow read: if request.auth != null
                  && request.auth.uid == userId.split('.')[0];
      allow write: if request.auth != null
                   && request.auth.uid == userId.split('.')[0]
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Everything else is locked down by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
